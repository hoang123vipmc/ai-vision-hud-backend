# ============================
# AI Vision HUD Backend - Env
# ============================

# Required: Get your Gemini API Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Change Gemini model (default: gemini-2.0-flash-exp)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-2.0-flash-exp

# Optional: Server port (default: 3000)
PORT=3000
